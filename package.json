{
  "name": "org-tree-experiments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @orgtree/api",
    "dev:web": "npm run dev -w @orgtree/web",
    "build": "npm run build -w @orgtree/api && npm run build -w @orgtree/web",
    "start": "npm run start -w @orgtree/api",
    "lint": "npm run lint -w @orgtree/web",
    "test": "npm run test -w @orgtree/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6"
  }
}
